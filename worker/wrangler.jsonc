{
  "name": "lafacevm-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-23",
  "vars": {
    "GITHUB_REPO": "Inter-Raptor/LaFaceV-M",
    "ALLOWED_ORIGIN": "https://inter-raptor.github.io"
  },
  "durable_objects": {
    "bindings": [{ "name": "COLLECTION", "class_name": "Collection" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Collection"] }]
}
